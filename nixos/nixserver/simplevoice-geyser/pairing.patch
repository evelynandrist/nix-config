+            return Bukkit.getScheduler().callSyncMethod(this, show).get(5, TimeUnit.SECONDS);
+        } catch (Exception e) {
+            logger.error("Failed to show pairing map", e);
+            return false;
+        }
+    }
+
+    @Override
+    public void hidePairing(UUID uuid) {
+        if (pairingMaps == null || !isEnabled()) {
+            return;
+        }
+
+        if (Bukkit.isPrimaryThread()) {
+            pairingMaps.hide(uuid);
+        } else {
+            Bukkit.getScheduler().runTask(this, () -> pairingMaps.hide(uuid));
+        }
+    }
+
+    /**
+     * Chat line plus action bar and a sound, so the invite is noticed in
+     * play without a form taking over the screen. Java clients get clickable
+     * Accept / Decline; Bedrock can't click chat and is pointed to the menu.
+     */
+    @Override
+    public void showInvite(SvgPlayer to, InviteManager.Invite invite) {
+        if (!isEnabled()) {
+            return;
+        }
+
+        Runnable show = () -> {
+            Player p = Bukkit.getPlayer(to.getUniqueId());
+            if (p == null) {
+                return;
+            }
+
+            boolean bedrock = GeyserHook.isEnabled()
+                    && Boolean.TRUE.equals(GeyserHook.isBedrock(p.getUniqueId()));
+            String prefix = ChatColor.translateAlternateColorCodes('&', SvgCore.getPrefix());
+            String intro = prefix + ChatColor.YELLOW + invite.fromName() + ChatColor.RESET
+                    + " invites you to the voice group " + ChatColor.YELLOW + "\"" + invite.groupName()
+                    + "\"" + ChatColor.RESET + ".";
+
+            if (bedrock) {
+                p.sendMessage(intro);
+                p.sendMessage(prefix + ChatColor.GRAY + "Open the voice menu (emote) to accept.");
+            } else {
+                TextComponent line = new TextComponent(TextComponent.fromLegacyText(intro + " "));
+
+                TextComponent accept = new TextComponent("[Accept]");
+                accept.setColor(net.md_5.bungee.api.ChatColor.GREEN);
+                accept.setClickEvent(new ClickEvent(ClickEvent.Action.RUN_COMMAND, "/svg accept"));
+
+                TextComponent decline = new TextComponent("[Decline]");
+                decline.setColor(net.md_5.bungee.api.ChatColor.RED);
+                decline.setClickEvent(new ClickEvent(ClickEvent.Action.RUN_COMMAND, "/svg decline"));
+
+                line.addExtra(accept);
+                line.addExtra(new TextComponent(" "));
+                line.addExtra(decline);
+                p.spigot().sendMessage(line);
+            }
+
+            p.spigot().sendMessage(ChatMessageType.ACTION_BAR, TextComponent.fromLegacyText(
+                    ChatColor.YELLOW + invite.fromName() + " invites you to voice group \""
+                            + invite.groupName() + "\""));
+            p.playSound(p.getLocation(), Sound.BLOCK_NOTE_BLOCK_PLING, SoundCategory.PLAYERS, 1.0f, 1.5f);
+        };
+
+        if (Bukkit.isPrimaryThread()) {
+            show.run();
+        } else {
+            Bukkit.getScheduler().runTask(this, show);
+        }
+    }
 }
