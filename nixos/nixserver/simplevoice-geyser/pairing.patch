@@ -0,0 +1,452 @@
+package io.github.theodoremeyer.simplevoicegeyser.spigotmc.impl;
+
+import io.nayuki.qrcodegen.DataTooLongException;
+import io.nayuki.qrcodegen.QrCode;
+import org.bukkit.Bukkit;
+import org.bukkit.ChatColor;
+import org.bukkit.Material;
+import org.bukkit.NamespacedKey;
+import org.bukkit.entity.ItemFrame;
+import org.bukkit.entity.Player;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.Listener;
+import org.bukkit.event.entity.PlayerDeathEvent;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.event.inventory.InventoryDragEvent;
+import org.bukkit.event.inventory.InventoryType;
+import org.bukkit.event.player.PlayerDropItemEvent;
+import org.bukkit.event.player.PlayerInteractEntityEvent;
+import org.bukkit.event.player.PlayerJoinEvent;
+import org.bukkit.inventory.Inventory;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.PlayerInventory;
+import org.bukkit.inventory.meta.ItemMeta;
+import org.bukkit.inventory.meta.MapMeta;
+import org.bukkit.map.MapCanvas;
+import org.bukkit.map.MapRenderer;
+import org.bukkit.map.MapView;
+import org.bukkit.persistence.PersistentDataContainer;
+import org.bukkit.persistence.PersistentDataType;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.bukkit.scheduler.BukkitTask;
+import org.bukkit.util.io.BukkitObjectInputStream;
+import org.bukkit.util.io.BukkitObjectOutputStream;
+
+import java.awt.Color;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.ListIterator;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.logging.Level;
+
+/**
+ * Shows the pairing link as a QR code on a map in the player's hand.
+ * <p>
+ * The map is a temporary item: it is removed when the pairing is used or
+ * expires, when the player leaves or dies, and it can't be put into
+ * containers, crafting grids or item frames.
+ * <p>
+ * The map always goes into the hand, also with a full inventory: then the
+ * held item is stored inside the map item itself and put back when the map
+ * goes away (also after a crash: leftover maps are swapped back on join, and
+ * on death the stored item drops instead of the map). Everything here runs
+ * on the main thread.
+ */
+public final class PairingMaps implements Listener {
+
+    /** Map size in pixels. */
+    private static final int MAP_SIZE = 128;
+
+    /** Minimum white margin around the code (the map background is white). */
+    private static final int MIN_MARGIN = 2;
+
+    private final JavaPlugin plugin;
+    private final NamespacedKey key;
+    private final NamespacedKey stashKey;
+
+    /** One map id per player and server run, reused for later pairings. */
+    private final Map<UUID, MapView> views = new ConcurrentHashMap<>();
+    private final Map<UUID, Shown> shown = new ConcurrentHashMap<>();
+
+    /**
+     * A shown map.
+     * @param mapSlot slot the map was put in
+     * @param previousHeldSlot held slot before
+     * @param expiry task that removes the map
+     */
+    private record Shown(int mapSlot, int previousHeldSlot, BukkitTask expiry) {}
+
+    /**
+     * @param plugin the plugin
+     */
+    public PairingMaps(JavaPlugin plugin) {
+        this.plugin = plugin;
+        this.key = new NamespacedKey(plugin, "pairing_map");
+        this.stashKey = new NamespacedKey(plugin, "pairing_stash");
+    }
+
+    /**
+     * Put a QR map into the player's hand.
+     * @param player player
+     * @param link link to encode
+     * @param expiresAtMillis when to remove it again
+     * @return whether the map is shown
+     */
+    public boolean show(Player player, String link, long expiresAtMillis) {
+        QrCode qr;
+        try {
+            // smallest code that fits, so the modules are as big as possible;
+            // the error correction is raised if that still fits
+            qr = QrCode.encodeText(link, QrCode.Ecc.LOW);
+        } catch (DataTooLongException e) {
+            plugin.getLogger().warning("Pairing link too long for a QR map: " + link.length() + " chars");
+            return false;
+        }
+        if (qr.size + 2 * MIN_MARGIN > MAP_SIZE) {
+            return false;
+        }
+
+        hide(player);
+
+        PlayerInventory inv = player.getInventory();
+        int held = inv.getHeldItemSlot();
+        int mapSlot = -1;
+
+        if (isEmpty(inv.getItem(held))) {
+            mapSlot = held;
+        } else {
+            for (int slot = 0; slot < 9; slot++) {
+                if (isEmpty(inv.getItem(slot))) {
+                    mapSlot = slot;
+                    break;
+                }
+            }
+        }
+
+        // hotbar full: the held item goes into the map item for a moment
+        ItemStack stash = null;
+        if (mapSlot == -1) {
+            mapSlot = held;
+            stash = inv.getItem(held);
+        }
+
+        MapView view = views.computeIfAbsent(player.getUniqueId(), uuid -> Bukkit.createMap(player.getWorld()));
+        for (MapRenderer renderer : new ArrayList<>(view.getRenderers())) {
+            view.removeRenderer(renderer);
+        }
+        view.setScale(MapView.Scale.CLOSEST);
+        view.setTrackingPosition(false);
+        view.setUnlimitedTracking(false);
+        view.addRenderer(new QrRenderer(qr));
+
+        ItemStack item = new ItemStack(Material.FILLED_MAP);
+        MapMeta meta = (MapMeta) item.getItemMeta();
+        if (meta == null) {
+            return false;
+        }
+        meta.setMapView(view);
+        meta.setDisplayName(ChatColor.AQUA + "Voice chat login");
+        List<String> lore = new ArrayList<>(List.of(
+                ChatColor.GRAY + "Scan it with your phone's camera.",
+                ChatColor.GRAY + "Disappears after use."
+        ));
+        PersistentDataContainer data = meta.getPersistentDataContainer();
+        data.set(key, PersistentDataType.BYTE, (byte) 1);
+        if (stash != null) {
+            try {
+                data.set(stashKey, PersistentDataType.BYTE_ARRAY, serialize(stash));
+            } catch (Exception e) {
+                plugin.getLogger().log(Level.WARNING, "Could not store the held item, no QR map", e);
+                return false;
+            }
+            lore.add(ChatColor.GRAY + "Your item comes back when it disappears.");
+        }
+        meta.setLore(lore);
+        item.setItemMeta(meta);
+
+        inv.setItem(mapSlot, item);
+        inv.setHeldItemSlot(mapSlot);
+
+        long ticks = Math.max(20, (expiresAtMillis - System.currentTimeMillis()) / 50);
+        UUID uuid = player.getUniqueId();
+        BukkitTask expiry = Bukkit.getScheduler().runTaskLater(plugin, () -> hide(uuid), ticks);
+
+        shown.put(uuid, new Shown(mapSlot, held, expiry));
+        return true;
+    }
+
+    /**
+     * Remove the QR map again and give back the stored item.
+     * @param player player
+     */
+    public void hide(Player player) {
+        Shown state = shown.remove(player.getUniqueId());
+        if (state != null) {
+            state.expiry().cancel();
+        }
+
+        removeTagged(player);
+
+        PlayerInventory inv = player.getInventory();
+        if (state != null && inv.getHeldItemSlot() == state.mapSlot()
+                && isEmpty(inv.getItem(state.mapSlot()))) {
+            inv.setHeldItemSlot(state.previousHeldSlot());
+        }
+    }
+
+    /**
+     * Remove the QR map of a player by uuid, if online.
+     * @param uuid player
+     */
+    public void hide(UUID uuid) {
+        Player player = Bukkit.getPlayer(uuid);
+        if (player != null) {
+            hide(player);
+        } else {
+            Shown state = shown.remove(uuid);
+            if (state != null) {
+                state.expiry().cancel();
+            }
+        }
+    }
+
+    /**
+     * Remove every QR map (plugin disable).
+     */
+    public void hideAll() {
+        for (UUID uuid : new ArrayList<>(shown.keySet())) {
+            hide(uuid);
+        }
+    }
+
+    /**
+     * Swap every pairing map in the inventory (and on the cursor) back for
+     * the item stored in it, or nothing.
+     */
+    private void removeTagged(Player player) {
+        PlayerInventory inv = player.getInventory();
+        ItemStack[] contents = inv.getContents();
+        for (int i = 0; i < contents.length; i++) {
+            if (isPairingMap(contents[i])) {
+                ItemStack back = unstash(contents[i], player);
+                if (back != contents[i]) {
+                    inv.setItem(i, back);
+                }
+            }
+        }
+        ItemStack cursor = player.getItemOnCursor();
+        if (isPairingMap(cursor)) {
+            ItemStack back = unstash(cursor, player);
+            if (back != cursor) {
+                player.setItemOnCursor(back);
+            }
+        }
+    }
+
+    /**
+     * What a pairing map turns back into.
+     * @return the stored item, null if none, or the map itself if the stored
+     *         item can't be read (so it is never lost)
+     */
+    private ItemStack unstash(ItemStack map, Player player) {
+        ItemMeta meta = map.getItemMeta();
+        byte[] bytes = meta == null ? null
+                : meta.getPersistentDataContainer().get(stashKey, PersistentDataType.BYTE_ARRAY);
+        if (bytes == null) {
+            return null;
+        }
+        try {
+            return deserialize(bytes);
+        } catch (Exception e) {
+            plugin.getLogger().log(Level.SEVERE, "Could not restore the item stored in "
+                    + player.getName() + "'s pairing map; leaving the map in place", e);
+            return map;
+        }
+    }
+
+    private boolean isPairingMap(ItemStack item) {
+        if (item == null || item.getType() != Material.FILLED_MAP || !item.hasItemMeta()) {
+            return false;
+        }
+        ItemMeta meta = item.getItemMeta();
+        return meta != null && meta.getPersistentDataContainer().has(key, PersistentDataType.BYTE);
+    }
+
+    private boolean hasStash(ItemStack item) {
+        ItemMeta meta = item == null ? null : item.getItemMeta();
+        return meta != null && meta.getPersistentDataContainer().has(stashKey, PersistentDataType.BYTE_ARRAY);
+    }
+
+    private static boolean isEmpty(ItemStack item) {
+        return item == null || item.getType().isAir();
+    }
+
+    // Paper: ItemStack#serializeAsBytes / deserializeBytes, Spigot: Bukkit object streams
+
+    private static byte[] serialize(ItemStack item) throws Exception {
+        try {
+            Method method = ItemStack.class.getMethod("serializeAsBytes");
+            return (byte[]) method.invoke(item);
+        } catch (NoSuchMethodException ignored) {
+            // not Paper
+        }
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        try (BukkitObjectOutputStream out = new BukkitObjectOutputStream(bytes)) {
+            out.writeObject(item);
+        }
+        return bytes.toByteArray();
+    }
+
+    private static ItemStack deserialize(byte[] data) throws Exception {
+        try {
+            Method method = ItemStack.class.getMethod("deserializeBytes", byte[].class);
+            return (ItemStack) method.invoke(null, (Object) data);
+        } catch (NoSuchMethodException ignored) {
+            // not Paper
+        }
+        try (BukkitObjectInputStream in = new BukkitObjectInputStream(new ByteArrayInputStream(data))) {
+            return (ItemStack) in.readObject();
+        }
+    }
+
+    //---------------------------------------------
+    // keep the map from leaving the player's hands
+    //---------------------------------------------
+
+    @EventHandler
+    public void onJoin(PlayerJoinEvent event) {
+        // leftovers from a crash or restart
+        removeTagged(event.getPlayer());
+    }
+
+    @EventHandler(priority = EventPriority.LOWEST)
+    public void onDeath(PlayerDeathEvent event) {
+        Player player = event.getEntity();
+        // the stored item drops (or goes into the grave) instead of the map
+        ListIterator<ItemStack> drops = event.getDrops().listIterator();
+        while (drops.hasNext()) {
+            ItemStack drop = drops.next();
+            if (isPairingMap(drop)) {
+                ItemStack back = unstash(drop, player);
+                if (back == null) {
+                    drops.remove();
+                } else {
+                    drops.set(back);
+                }
+            }
+        }
+        if (event.getKeepInventory()) {
+            removeTagged(player);
+        }
+        Shown state = shown.remove(player.getUniqueId());
+        if (state != null) {
+            state.expiry().cancel();
+        }
+    }
+
+    @EventHandler(ignoreCancelled = true)
+    public void onDrop(PlayerDropItemEvent event) {
+        ItemStack item = event.getItemDrop().getItemStack();
+        if (!isPairingMap(item)) {
+            return;
+        }
+        if (hasStash(item)) {
+            event.setCancelled(true); // it holds the player's item, keep it
+        } else {
+            event.getItemDrop().remove(); // dropping it means "done with it"
+        }
+    }
+
+    @EventHandler(ignoreCancelled = true)
+    public void onClick(InventoryClickEvent event) {
+        boolean involved = isPairingMap(event.getCurrentItem()) || isPairingMap(event.getCursor());
+        if (!involved && event.getHotbarButton() >= 0) {
+            involved = isPairingMap(event.getWhoClicked().getInventory().getItem(event.getHotbarButton()));
+        }
+        if (!involved) {
+            return;
+        }
+
+        Inventory top = event.getView().getTopInventory();
+        InventoryType type = top.getType();
+        boolean ownInventoryOnly = type == InventoryType.CRAFTING || type == InventoryType.CREATIVE;
+
+        // anything with a chest etc. open, and the 2x2 crafting grid
+        if (!ownInventoryOnly || top.equals(event.getClickedInventory())) {
+            event.setCancelled(true);
+        }
+    }
+
+    @EventHandler(ignoreCancelled = true)
+    public void onDrag(InventoryDragEvent event) {
+        if (!isPairingMap(event.getOldCursor())) {
+            return;
+        }
+        int topSize = event.getView().getTopInventory().getSize();
+        for (int raw : event.getRawSlots()) {
+            if (raw < topSize) {
+                event.setCancelled(true);
+                return;
+            }
+        }
+    }
+
+    @EventHandler(ignoreCancelled = true)
+    public void onItemFrame(PlayerInteractEntityEvent event) {
+        if (event.getRightClicked() instanceof ItemFrame) {
+            ItemStack hand = event.getPlayer().getInventory().getItem(event.getHand());
+            if (isPairingMap(hand)) {
+                event.setCancelled(true);
+            }
+        }
+    }
+
+    /**
+     * Draws a QR code, black on white, as big as fits.
+     */
+    private static final class QrRenderer extends MapRenderer {
+
+        private final QrCode qr;
+        private boolean drawn = false;
+
+        QrRenderer(QrCode qr) {
+            super(false);
+            this.qr = qr;
+        }
+
+        @Override
+        public void render(MapView map, MapCanvas canvas, Player player) {
+            if (drawn) {
+                return;
+            }
+            drawn = true;
+
+            int scale = (MAP_SIZE - 2 * MIN_MARGIN) / qr.size;
+            int offset = (MAP_SIZE - qr.size * scale) / 2;
+
+            for (int x = 0; x < MAP_SIZE; x++) {
+                for (int y = 0; y < MAP_SIZE; y++) {
+                    canvas.setPixelColor(x, y, Color.WHITE);
+                }
+            }
+            for (int mx = 0; mx < qr.size; mx++) {
+                for (int my = 0; my < qr.size; my++) {
+                    if (!qr.getModule(mx, my)) {
+                        continue;
+                    }
+                    for (int dx = 0; dx < scale; dx++) {
+                        for (int dy = 0; dy < scale; dy++) {
+                            canvas.setPixelColor(offset + mx * scale + dx, offset + my * scale + dy, Color.BLACK);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
