+import io.github.theodoremeyer.simplevoicegeyser.core.server.servlets.JettyWebSocket;
+import org.json.JSONObject;
+
+/**
+ * Liveness check from the browser. A phone coming back from the background
+ * often holds a socket that looks open but is dead; the page sends a ping
+ * and replaces the socket when no pong arrives.
+ */
+public final class PingPacket implements Packet {
+
+    /**
+     * A no arg Constructor
+     */
+    public PingPacket() {}
+
+    @Override
+    public String getType() {
+        return "ping";
+    }
+
+    @Override
+    public void handle(JettyWebSocket socket, JSONObject json) {
+        if (socket.getConnection() == null) {
+            return;
+        }
+        socket.getConnection().sendJson(new JSONObject().put("type", "pong"));
+    }
+}
