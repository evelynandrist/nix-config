+package io.github.theodoremeyer.simplevoicegeyser.core.server.connection.auth;
+
+import io.github.theodoremeyer.simplevoicegeyser.core.SvgCore;
+import io.github.theodoremeyer.simplevoicegeyser.core.api.sender.SvgPlayer;
+import io.github.theodoremeyer.simplevoicegeyser.core.data.DeviceStore;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+import java.security.SecureRandom;
+import java.time.Duration;
+import java.util.Base64;
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+
+/**
+ * Password-less login: an in-game player asks for a one-time pairing, which
+ * has two forms that both work once and expire after a short time:
+ * <ul>
+ *     <li>a long random token, put into a link and shown as a QR code
+ *         (https://voice.example.com/#pair=TOKEN), and</li>
+ *     <li>a short code to type in, like {@code K7F3-QX9M}.</li>
+ * </ul>
+ * The browser that redeems it gets a device token ({@link DeviceStore}) and
+ * logs in with that from then on.
+ */
+public final class PairingManager {
+
+    /** Code alphabet: no 0/O, 1/I/L. 31 symbols, 8 of them ~ 39.6 bits. */
+    private static final char[] CODE_ALPHABET = "23456789ABCDEFGHJKMNPQRSTUVWXYZ".toCharArray();
+    private static final int CODE_LENGTH = 8;
+
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private final DeviceStore devices;
+
+    /** Wrong codes per client address. */
+    private final AuthRateLimiter perClientLimiter =
+            new AuthRateLimiter(10, Duration.ofMinutes(5), Duration.ofMinutes(15));
+
+    /** Wrong codes from everyone together, a backstop for many addresses. */
+    private final AuthRateLimiter globalLimiter =
+            new AuthRateLimiter(60, Duration.ofMinutes(5), Duration.ofMinutes(5));
+
+    private final Map<String, Pairing> byToken = new HashMap<>();
+    private final Map<String, Pairing> byCode = new HashMap<>();
+    private final Map<UUID, Pairing> byPlayer = new HashMap<>();
+
+    /**
+     * A pending pairing.
+     * @param uuid player
+     * @param name player name
+     * @param token long token for the QR link
+     * @param code short code, without the dash
+     * @param expiresAt epoch millis
+     */
+    public record Pairing(UUID uuid, String name, String token, String code, long expiresAt) {
+
+        /**
+         * @return the code as shown to players, e.g. K7F3-QX9M
+         */
+        public String displayCode() {
+            return code.substring(0, 4) + "-" + code.substring(4);
+        }
+
+        /**
+         * @param baseUrl public URL of the web page
+         * @return link that pairs the browser that opens it, or null without a base URL
+         */
+        @Nullable
+        public String link(String baseUrl) {
+            if (baseUrl == null || baseUrl.isBlank()) {
+                return null;
+            }
+            String base = baseUrl.trim();
+            if (!base.endsWith("/")) {
+                base += "/";
+            }
+            // a fragment never reaches the server (or proxy logs)
+            return base + "#pair=" + token;
+        }
+
+        /**
+         * @return seconds until it expires
+         */
+        public long secondsLeft() {
+            return Math.max(0, (expiresAt - System.currentTimeMillis()) / 1000);
+        }
+    }
+
+    /**
+     * Result of redeeming a pairing.
+     * @param uuid player, null on failure
+     * @param message failure message
+     */
+    public record Redeemed(@Nullable UUID uuid, @Nullable String message) {
+        static Redeemed ok(UUID uuid) {
+            return new Redeemed(uuid, null);
+        }
+
+        static Redeemed fail(String message) {
+            return new Redeemed(null, message);
+        }
+    }
+
+    /**
+     * @param devices device token store
+     */
+    public PairingManager(DeviceStore devices) {
+        this.devices = devices;
+    }
+
+    /**
+     * @return device token store
+     */
+    public DeviceStore getDevices() {
+        return devices;
+    }
+
+    /**
+     * Start a pairing for a player. An older pending pairing of that player is
+     * replaced.
+     * @param player player
+     * @return the pairing
+     */
+    public synchronized Pairing create(SvgPlayer player) {
+        purgeExpired();
+        remove(byPlayer.get(player.getUniqueId()));
+
+        int ttl = Math.max(30, SvgCore.getConfig().PAIRING_TTL_SECONDS.get());
+
+        String token;
+        do {
+            byte[] bytes = new byte[16];
+            RANDOM.nextBytes(bytes);
+            token = Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
+        } while (byToken.containsKey(token));
+
+        String code;
+        do {
+            char[] chars = new char[CODE_LENGTH];
+            for (int i = 0; i < CODE_LENGTH; i++) {
+                chars[i] = CODE_ALPHABET[RANDOM.nextInt(CODE_ALPHABET.length)];
+            }
+            code = new String(chars);
+        } while (byCode.containsKey(code));
+
+        Pairing pairing = new Pairing(
+                player.getUniqueId(), player.getName(), token, code,
+                System.currentTimeMillis() + ttl * 1000L
+        );
+        byToken.put(token, pairing);
+        byCode.put(code, pairing);
+        byPlayer.put(pairing.uuid(), pairing);
+        return pairing;
+    }
+
+    /**
+     * Cancel a player's pending pairing (e.g. when they leave).
+     * @param uuid player
+     */
+    public synchronized void cancel(UUID uuid) {
+        remove(byPlayer.get(uuid));
+    }
+
+    /**
+     * Redeem the long token from a QR link.
+     * @param token token
+     * @return result
+     */
+    public synchronized Redeemed redeemToken(String token) {
+        purgeExpired();
+        Pairing pairing = token == null ? null : byToken.get(token.trim());
+        if (pairing == null) {
+            return Redeemed.fail("This pairing link has expired or was already used. "
+                    + "Make a new one in-game.");
+        }
+        remove(pairing);
+        return Redeemed.ok(pairing.uuid());
+    }
+
+    /**
+     * Redeem a typed code. Wrong codes are rate-limited per client and globally.
+     * @param rawCode code as typed (case, spaces and dashes don't matter)
+     * @param clientKey client address
+     * @return result
+     */
+    public synchronized Redeemed redeemCode(String rawCode, String clientKey) {
+        purgeExpired();
+
+        String clientLimitKey = "pair:" + clientKey;
+        if (!perClientLimiter.allow(clientLimitKey) || !globalLimiter.allow("pair:*")) {
+            return Redeemed.fail("Too many wrong codes. Wait a few minutes and try again.");
+        }
+
+        String code = normalizeCode(rawCode);
+        Pairing pairing = code.isEmpty() ? null : byCode.get(code);
+        if (pairing == null) {
+            perClientLimiter.recordFailure(clientLimitKey);
+            globalLimiter.recordFailure("pair:*");
+            return Redeemed.fail("Wrong or expired code. Make a new one in-game.");
+        }
+
+        remove(pairing);
+        return Redeemed.ok(pairing.uuid());
+    }
+
+    /**
+     * Upper case, without spaces and dashes.
+     * @param raw typed code
+     * @return normalized code
+     */
+    static String normalizeCode(String raw) {
+        if (raw == null) {
+            return "";
+        }
+        StringBuilder out = new StringBuilder();
+        for (char c : raw.toUpperCase(Locale.ROOT).toCharArray()) {
+            if (Character.isLetterOrDigit(c)) {
+                out.append(c);
+            }
+        }
+        return out.length() == CODE_LENGTH ? out.toString() : "";
+    }
+
+    private void remove(@Nullable Pairing pairing) {
+        if (pairing == null) {
+            return;
+        }
+        byToken.remove(pairing.token());
+        byCode.remove(pairing.code());
+        byPlayer.remove(pairing.uuid(), pairing);
+        SvgCore.getPlatform().hidePairing(pairing.uuid());
+    }
+
+    private void purgeExpired() {
+        long now = System.currentTimeMillis();
+        for (Pairing pairing : byPlayer.values().toArray(new Pairing[0])) {
+            if (pairing.expiresAt() <= now) {
+                remove(pairing);
+            }
+        }
+    }
+}
