@@ -0,0 +1,216 @@
+package io.github.theodoremeyer.simplevoicegeyser.core.data;
+
+import io.github.theodoremeyer.simplevoicegeyser.core.api.chat.SvgLogger;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+/**
+ * Remembers browsers that were paired with a player ("device tokens"),
+ * so they can log in again without a password.
+ * <p>
+ * Only a SHA-256 hash of each token is stored (devices.json). The tokens
+ * are 256 random bits, so a plain hash is enough; no salt or bcrypt needed.
+ */
+public final class DeviceStore {
+
+    /** Most devices kept per player; the least recently used one is dropped. */
+    private static final int MAX_DEVICES_PER_PLAYER = 10;
+
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private final File file;
+    private final File tempFile;
+    private final SvgLogger logger;
+
+    /** token hash -> device */
+    private final Map<String, Device> devices = new HashMap<>();
+
+    /**
+     * Load the device file from the plugin data folder.
+     * @param dataFolder plugin data folder
+     * @param logger logger
+     */
+    public DeviceStore(File dataFolder, SvgLogger logger) {
+        this.file = new File(dataFolder, "devices.json");
+        this.tempFile = new File(dataFolder, "devices.json.tmp");
+        this.logger = logger;
+        load();
+    }
+
+    /**
+     * Create and remember a new device token for a player.
+     * @param uuid player uuid
+     * @param username player name (for display only)
+     * @return the token; give it to the browser, it is not stored in clear
+     */
+    public synchronized String issue(UUID uuid, String username) {
+        byte[] bytes = new byte[32];
+        RANDOM.nextBytes(bytes);
+        String token = Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
+
+        long now = System.currentTimeMillis();
+        Device device = new Device();
+        device.uuid = uuid.toString();
+        device.username = username;
+        device.created = now;
+        device.lastUsed = now;
+        devices.put(hash(token), device);
+
+        // keep the newest MAX_DEVICES_PER_PLAYER of this player
+        List<Map.Entry<String, Device>> own = new ArrayList<>();
+        for (Map.Entry<String, Device> e : devices.entrySet()) {
+            if (e.getValue().uuid.equals(device.uuid)) {
+                own.add(e);
+            }
+        }
+        if (own.size() > MAX_DEVICES_PER_PLAYER) {
+            own.sort(Comparator.comparingLong(e -> e.getValue().lastUsed));
+            for (int i = 0; i < own.size() - MAX_DEVICES_PER_PLAYER; i++) {
+                devices.remove(own.get(i).getKey());
+            }
+        }
+
+        save();
+        return token;
+    }
+
+    /**
+     * Look up the player a device token belongs to.
+     * @param token token from the browser
+     * @param maxIdleDays forget devices unused for this many days (0 = never)
+     * @return the player's uuid, or null if the token is unknown or expired
+     */
+    @Nullable
+    public synchronized UUID validate(String token, int maxIdleDays) {
+        if (token == null || token.isBlank() || token.length() > 128) {
+            return null;
+        }
+
+        String key = hash(token);
+        Device device = devices.get(key);
+        if (device == null) {
+            return null;
+        }
+
+        long now = System.currentTimeMillis();
+        if (maxIdleDays > 0 && now - device.lastUsed > maxIdleDays * 86_400_000L) {
+            devices.remove(key);
+            save();
+            return null;
+        }
+
+        // only write the file at most once an hour per device
+        if (now - device.lastUsed > 3_600_000L) {
+            device.lastUsed = now;
+            save();
+        }
+
+        try {
+            return UUID.fromString(device.uuid);
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+    }
+
+    /**
+     * Sign out all browsers of a player.
+     * @param uuid player uuid
+     * @return number of devices removed
+     */
+    public synchronized int revokeAll(UUID uuid) {
+        String id = uuid.toString();
+        int before = devices.size();
+        devices.values().removeIf(d -> id.equals(d.uuid));
+        int removed = before - devices.size();
+        if (removed > 0) {
+            save();
+        }
+        return removed;
+    }
+
+    /**
+     * Count the browsers paired with a player.
+     * @param uuid player uuid
+     * @return count
+     */
+    public synchronized int count(UUID uuid) {
+        String id = uuid.toString();
+        return (int) devices.values().stream().filter(d -> id.equals(d.uuid)).count();
+    }
+
+    private void load() {
+        if (!file.exists()) {
+            return;
+        }
+        try {
+            JSONObject json = new JSONObject(Files.readString(file.toPath(), StandardCharsets.UTF_8));
+            for (String key : json.keySet()) {
+                JSONObject entry = json.optJSONObject(key);
+                if (entry == null || entry.optString("uuid", "").isEmpty()) {
+                    continue;
+                }
+                Device device = new Device();
+                device.uuid = entry.getString("uuid");
+                device.username = entry.optString("username", "");
+                device.created = entry.optLong("created", 0);
+                device.lastUsed = entry.optLong("lastUsed", 0);
+                devices.put(key, device);
+            }
+        } catch (Exception e) {
+            logger.error("Failed to load devices file", e);
+        }
+    }
+
+    private void save() {
+        JSONObject json = new JSONObject();
+        for (Map.Entry<String, Device> e : devices.entrySet()) {
+            Device d = e.getValue();
+            json.put(e.getKey(), new JSONObject()
+                    .put("uuid", d.uuid)
+                    .put("username", d.username)
+                    .put("created", d.created)
+                    .put("lastUsed", d.lastUsed));
+        }
+        try {
+            Files.writeString(tempFile.toPath(), json.toString(2), StandardCharsets.UTF_8);
+            Files.move(tempFile.toPath(), file.toPath(),
+                    StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+        } catch (IOException e) {
+            logger.error("Failed to write devices file", e);
+        }
+    }
+
+    private static String hash(String token) {
+        try {
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            byte[] out = digest.digest(token.getBytes(StandardCharsets.UTF_8));
+            return Base64.getUrlEncoder().withoutPadding().encodeToString(out);
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException("SHA-256 unavailable", e);
+        }
+    }
+
+    /** One remembered browser. */
+    private static final class Device {
+        String uuid;
+        String username;
+        long created;
+        long lastUsed;
+    }
+}
