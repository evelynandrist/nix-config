diff --git a/core/src/main/java/io/github/theodoremeyer/simplevoicegeyser/core/managers/InviteManager.java b/core/src/main/java/io/github/theodoremeyer/simplevoicegeyser/core/managers/InviteManager.java
new file mode 100644
index 0000000..d2dd8c0
--- /dev/null
+++ b/core/src/main/java/io/github/theodoremeyer/simplevoicegeyser/core/managers/InviteManager.java
@@ -0,0 +1,185 @@
+package io.github.theodoremeyer.simplevoicegeyser.core.managers;
+
+import io.github.theodoremeyer.simplevoicegeyser.core.SvgCore;
+import io.github.theodoremeyer.simplevoicegeyser.core.api.chat.SvgColor;
+import io.github.theodoremeyer.simplevoicegeyser.core.api.sender.SvgPlayer;
+
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Group invites. An invite is a pending state, not a pop-up: the invitee is
+ * told about it (chat, action bar, sound) and accepts whenever it suits
+ * them, from the Bedrock menu or with /svg accept. Nothing interrupts play.
+ * <p>
+ * Accepting skips the group password, like Simple Voice Chat's own
+ * /voicechat invite. A player has at most one pending invite; a newer one
+ * replaces it. Invites expire after {@link #TTL_MILLIS}.
+ */
+public final class InviteManager {
+
+    /**
+     * How long an invite can be accepted
+     */
+    public static final long TTL_MILLIS = 2 * 60 * 1000;
+
+    /**
+     * A pending invite
+     * @param from the inviting player
+     * @param fromName the inviting player's name
+     * @param groupName the group to join
+     * @param expiresAt epoch millis
+     */
+    public record Invite(UUID from, String fromName, String groupName, long expiresAt) {
+
+        /**
+         * Whether the invite can no longer be accepted
+         * @return whether it expired
+         */
+        public boolean expired() {
+            return System.currentTimeMillis() > expiresAt;
+        }
+    }
+
+    private final Map<UUID, Invite> pending = new ConcurrentHashMap<>();
+    private final GroupManager groupManager;
+
+    /**
+     * Create the manager
+     * @param groupManager the group manager to join groups with
+     */
+    public InviteManager(GroupManager groupManager) {
+        this.groupManager = groupManager;
+    }
+
+    /**
+     * Invite a player into the inviter's current group
+     * @param from the inviting player
+     * @param to the invited player
+     * @return whether the invite was sent
+     */
+    public boolean invite(SvgPlayer from, SvgPlayer to) {
+        String prefix = SvgCore.getPrefix();
+
+        if (to == null || !to.isOnline()) {
+            from.sendMessage(prefix + SvgColor.RED + "That player is not online.");
+            return false;
+        }
+
+        if (to.getUniqueId().equals(from.getUniqueId())) {
+            from.sendMessage(prefix + SvgColor.RED + "You can't invite yourself.");
+            return false;
+        }
+
+        Optional<String> groupName = groupManager.getJoinedGroupName(from);
+        if (groupName.isEmpty()) {
+            from.sendMessage(prefix + SvgColor.RED + "Join or create a group first.");
+            return false;
+        }
+
+        if (!to.hasPermission("svg.vc.group.join")) {
+            from.sendMessage(prefix + SvgColor.RED + to.getDisplayName() + " is not allowed to join groups.");
+            return false;
+        }
+
+        if (groupName.equals(groupManager.getJoinedGroupName(to))) {
+            from.sendMessage(prefix + SvgColor.RED + to.getDisplayName() + " is already in your group.");
+            return false;
+        }
+
+        // names shown to players are nicknames (forms don't go through the
+        // server's chat, so they can't be swapped later)
+        Invite invite = new Invite(from.getUniqueId(), from.getDisplayName(), groupName.get(),
+                System.currentTimeMillis() + TTL_MILLIS);
+        pending.put(to.getUniqueId(), invite);
+
+        SvgCore.getPlatform().showInvite(to, invite);
+
+        from.sendMessage(prefix + SvgColor.GREEN + "Invited " + to.getDisplayName() + " to \""
+                + groupName.get() + "\"." + SvgColor.GRAY + " They have " + (TTL_MILLIS / 60000)
+                + " minutes to accept.");
+        return true;
+    }
+
+    /**
+     * The invite waiting for a player, if any
+     * @param uuid the invited player
+     * @return the invite, or null
+     */
+    public Invite getPending(UUID uuid) {
+        Invite invite = pending.get(uuid);
+        if (invite != null && invite.expired()) {
+            pending.remove(uuid, invite);
+            return null;
+        }
+        return invite;
+    }
+
+    /**
+     * Accept the pending invite: join the group without a password
+     * @param player the invited player
+     * @return whether they joined
+     */
+    public boolean accept(SvgPlayer player) {
+        String prefix = SvgCore.getPrefix();
+        Invite invite = pending.remove(player.getUniqueId());
+
+        if (invite == null || invite.expired()) {
+            player.sendMessage(prefix + SvgColor.RED + "There is no invite waiting for you.");
+            return false;
+        }
+
+        if (!player.hasPermission("svg.vc.group.join")) {
+            player.sendMessage(prefix + SvgColor.RED + "You are not allowed to join groups.");
+            return false;
+        }
+
+        if (!groupManager.joinInvited(player, invite.groupName())) {
+            player.sendMessage(prefix + SvgColor.RED + "The group \"" + invite.groupName()
+                    + "\" doesn't exist anymore.");
+            return false;
+        }
+
+        player.sendMessage(prefix + SvgColor.GREEN + "Joined " + invite.fromName()
+                + "'s group \"" + invite.groupName() + "\".");
+
+        SvgPlayer from = SvgCore.getPlayerManager().getPlayer(invite.from());
+        if (from != null && from.isOnline()) {
+            from.sendMessage(prefix + SvgColor.GREEN + player.getDisplayName() + " joined your group.");
+        }
+        return true;
+    }
+
+    /**
+     * Turn down the pending invite
+     * @param player the invited player
+     */
+    public void decline(SvgPlayer player) {
+        String prefix = SvgCore.getPrefix();
+        Invite invite = pending.remove(player.getUniqueId());
+
+        if (invite == null || invite.expired()) {
+            player.sendMessage(prefix + SvgColor.RED + "There is no invite waiting for you.");
+            return;
+        }
+
+        player.sendMessage(prefix + "Declined " + invite.fromName() + "'s invite.");
+
+        SvgPlayer from = SvgCore.getPlayerManager().getPlayer(invite.from());
+        if (from != null && from.isOnline()) {
+            from.sendMessage(prefix + SvgColor.GRAY + player.getDisplayName() + " declined your invite.");
+        }
+    }
+
+    /**
+     * Forget everything about a player who left: their own invite and the
+     * ones they sent.
+     * @param uuid the player
+     */
+    public void clear(UUID uuid) {
+        pending.remove(uuid);
+        pending.values().removeIf(invite -> invite.from().equals(uuid));
+    }
+}
