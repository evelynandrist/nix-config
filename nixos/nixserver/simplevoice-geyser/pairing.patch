@@ -0,0 +1,69 @@
+package io.github.theodoremeyer.simplevoicegeyser.core.data;
+
+import io.github.theodoremeyer.simplevoicegeyser.core.api.chat.SvgLogger;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class DeviceStoreTest {
+
+    private static final SvgLogger LOGGER = new SvgLogger() {
+        public void info(String msg) {}
+        public void warning(String msg) {}
+        public void error(String msg) { fail(msg); }
+        public void severe(String msg) { fail(msg); }
+        public void error(String msg, Throwable t) { fail(msg, t); }
+    };
+
+    @TempDir
+    Path dir;
+
+    @Test
+    void issuedTokenValidatesAndSurvivesReload() throws Exception {
+        UUID uuid = UUID.randomUUID();
+        DeviceStore store = new DeviceStore(dir.toFile(), LOGGER);
+        String token = store.issue(uuid, "Steve");
+
+        assertEquals(uuid, store.validate(token, 180));
+        assertNull(store.validate(token + "x", 180));
+        assertNull(store.validate("", 180));
+
+        // stored hashed, never in clear
+        String json = Files.readString(new File(dir.toFile(), "devices.json").toPath());
+        assertFalse(json.contains(token));
+
+        DeviceStore reloaded = new DeviceStore(dir.toFile(), LOGGER);
+        assertEquals(uuid, reloaded.validate(token, 180));
+    }
+
+    @Test
+    void revokeAllRemovesOnlyThatPlayer() {
+        UUID a = UUID.randomUUID();
+        UUID b = UUID.randomUUID();
+        DeviceStore store = new DeviceStore(dir.toFile(), LOGGER);
+        String a1 = store.issue(a, "A");
+        String a2 = store.issue(a, "A");
+        String b1 = store.issue(b, "B");
+
+        assertEquals(2, store.revokeAll(a));
+        assertNull(store.validate(a1, 0));
+        assertNull(store.validate(a2, 0));
+        assertEquals(b, store.validate(b1, 0));
+    }
+
+    @Test
+    void keepsAtMostTenDevicesPerPlayer() {
+        UUID a = UUID.randomUUID();
+        DeviceStore store = new DeviceStore(dir.toFile(), LOGGER);
+        for (int i = 0; i < 15; i++) {
+            store.issue(a, "A");
+        }
+        assertEquals(10, store.count(a));
+    }
+}
