@@ -0,0 +1,111 @@
+package io.github.theodoremeyer.simplevoicegeyser.core.commands.svg;
+
+import io.github.theodoremeyer.simplevoicegeyser.core.SvgCore;
+import io.github.theodoremeyer.simplevoicegeyser.core.api.chat.SvgColor;
+import io.github.theodoremeyer.simplevoicegeyser.core.api.sender.Sender;
+import io.github.theodoremeyer.simplevoicegeyser.core.api.sender.SvgPlayer;
+import io.github.theodoremeyer.simplevoicegeyser.core.commands.CommandArgs;
+import io.github.theodoremeyer.simplevoicegeyser.core.commands.SubCommand;
+import io.github.theodoremeyer.simplevoicegeyser.core.geyser.FormHandler;
+import io.github.theodoremeyer.simplevoicegeyser.core.geyser.GeyserHook;
+import io.github.theodoremeyer.simplevoicegeyser.core.server.connection.auth.PairingManager;
+
+/**
+ * represents /svg pair: connect a browser without a password.
+ * <ul>
+ *     <li>/svg pair - one-time code + QR map, valid for a short time</li>
+ *     <li>/svg pair signout - forget all browsers paired with you</li>
+ * </ul>
+ */
+public final class PairCommand implements SubCommand {
+
+    /**
+     * Create the pair command
+     */
+    public PairCommand() {}
+
+    @Override
+    public String name() {
+        return "pair";
+    }
+
+    @Override
+    public boolean execute(CommandArgs args) {
+        Sender sender = args.getSender();
+
+        if (!(sender instanceof SvgPlayer player)) {
+            sender.sendMessage(SvgCore.getPrefix() + SvgColor.RED +
+                    "Only players can pair a browser.");
+            return true;
+        }
+
+        String action = args.get("action");
+        if (action != null && (action.equalsIgnoreCase("signout") || action.equalsIgnoreCase("logout"))) {
+            signOut(player);
+            return true;
+        }
+
+        start(player);
+        return true;
+    }
+
+    /**
+     * Start a pairing: chat message with the code, QR map if the platform
+     * can show one, and a form for Bedrock players.
+     * @param player player
+     * @return the pairing, or null if pairing is not allowed
+     */
+    public static PairingManager.Pairing start(SvgPlayer player) {
+        if (!SvgCore.getConfig().PAIRING_ENABLED.get()) {
+            player.sendMessage(SvgCore.getPrefix() + SvgColor.RED +
+                    "Pairing is turned off on this server.");
+            return null;
+        }
+
+        if (!player.hasPermission("svg.vc.join")) {
+            player.sendMessage(SvgCore.getPrefix() + SvgColor.RED +
+                    "You are not allowed to use voice chat.");
+            return null;
+        }
+
+        PairingManager.Pairing pairing = SvgCore.getPairingManager().create(player);
+
+        String baseUrl = SvgCore.getConfig().PAIRING_PUBLIC_URL.get();
+        String link = pairing.link(baseUrl);
+        boolean qrShown = link != null
+                && SvgCore.getPlatform().showPairing(player, link, pairing.expiresAt());
+
+        String site = baseUrl == null || baseUrl.isBlank() ? "the voice chat page" : baseUrl.trim();
+        long minutes = Math.max(1, Math.round(pairing.secondsLeft() / 60.0));
+
+        player.sendMessage(SvgCore.getPrefix() + "Open " + SvgColor.AQUA + site
+                + SvgColor.RESET + " and enter the code " + SvgColor.YELLOW + SvgColor.BOLD
+                + pairing.displayCode() + SvgColor.RESET
+                + " (valid " + minutes + " min, once).");
+
+        if (qrShown) {
+            player.sendMessage(SvgCore.getPrefix()
+                    + "Or scan the map in your hand with your phone's camera.");
+        }
+
+        FormHandler forms = GeyserHook.getFormHandler();
+        if (forms != null && GeyserHook.isEnabled()
+                && Boolean.TRUE.equals(GeyserHook.isBedrock(player.getUniqueId()))) {
+            forms.showPairing(player, pairing, site, qrShown);
+        }
+
+        return pairing;
+    }
+
+    /**
+     * Forget all browsers paired with a player.
+     * @param player player
+     */
+    public static void signOut(SvgPlayer player) {
+        SvgCore.getPairingManager().cancel(player.getUniqueId());
+        int removed = SvgCore.getPairingManager().getDevices().revokeAll(player.getUniqueId());
+        player.sendMessage(SvgCore.getPrefix() + "Signed out " + removed
+                + (removed == 1 ? " browser." : " browsers.")
+                + " Browsers that are connected right now stay connected until they leave.");
+    }
+}
